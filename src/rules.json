{
  "schemaVersion": 1,
  "specVersion": "D1.3",
  "project": "pond-check",
  "description": "鱼况体检的机器可读判定契约。所有阈值从这里读，实现里不许硬编码。配合 docs/SPEC.md 使用；两者冲突时以本文件为执行真相，并在同一次提交里修正 SPEC.md。",
  "updatedAt": "2026-11-07",
  "policy": {
    "neverDefaultToOk": true,
    "unknownIsNotOk": true,
    "note": "数据不足时必须输出 unknown 并列出 missing；不许 fallback 成上一个档位或 ok。假健康是本项目最高优先级缺陷。",
    "readOnly": true,
    "offline": true,
    "noNetworkModules": [
      "node:http",
      "node:https",
      "node:net",
      "node:dns",
      "node:tls"
    ],
    "forbiddenExec": [
      "sh",
      "bash",
      "zsh",
      "cmd",
      "powershell"
    ]
  },
  "severity": {
    "values": [
      "ok",
      "watch",
      "bad",
      "unknown"
    ],
    "rank": {
      "ok": 0,
      "watch": 1,
      "bad": 2,
      "unknown": 3
    },
    "note": "rank 只用于排序（坏的排上面）；unknown 的 rank 最高是为了不被折叠成正常，不表示它比 bad 更严重。"
  },
  "rollup": {
    "summaryFields": [
      "fish",
      "ok",
      "watch",
      "bad",
      "unknown"
    ],
    "fishOrder": [
      "bad",
      "unknown",
      "watch",
      "ok"
    ],
    "unknownNoteTemplate": "这些项不是正常，是没看到。",
    "missingFishTemplate": "没扫到鱼。确认她在跑（ps aux | grep -i <她的名字>），再用 --root <她的目录> 指窝。",
    "missingFishActionTemplate": "先确认她在跑（ps aux | grep -i <她的名字>），再用 --root 指窝。",
    "degradedFootnoteTemplate": "{count} 项数据读不到（{indicators}），不能当正常。",
    "verdictCellPrefix": "六格口径：",
    "filterMissTemplate": "过滤条件「{name}」没匹配到鱼（本次扫到 {count} 条）——真名见 stderr，改一下 --fish。",
    "filterMissActionTemplate": "改一下 --fish 的写法（本次扫到的真名见 stderr）。",
    "unknownNoTraceTemplate": "找到 {count} 个名字像鱼的插件，但没有任何运行痕迹（无日志/无判重表/无会话），可能只是界面组件。",
    "unknownNoTraceGenericTemplate": "找到 {count} 条名字像鱼的候选，但没有任何运行痕迹（无日志/无判重表/无会话），可能只是目录占位。",
    "unknownUnreadableTraceTemplate": "找到了运行痕迹但读不到内容，可能是权限或路径不匹配，试试 --root <她的目录>。",
    "unknownUnreadableTraceShort": "试试 --root，可能权限不对",
    "traceNoneAfterRootTemplate": "窝已指定但里面真的读不到：检查路径对不对、权限够不够、日志是不是真的写在这里。",
    "traceNoneAfterRootShort": "查路径/权限/日志在不在",
    "unknownBucketNoteTemplate": "认不出 = 存活与工作量两格都判不出（不是没这条鱼）。",
    "maxFixesPerFish": 3
  },
  "credentials": {
    "note": "命中即跳过：不 open、不 stat 内容、不读 mtime；路径在进入任何数据结构之前替换为 sensitivePathToken。报告里只允许出现聚合数量，绝不出现文件名或路径。唯一例外是 deps.credentialFreshness 按 knownCredentialPaths 白名单只取 mtime 天数，且永不返回路径。",
    "sensitivePathToken": "[凭证文件已跳过]",
    "skipFilePatterns": [
      "*credential*",
      "*credentials*",
      "*cred*",
      "*secret*",
      "*secrets*",
      "secrets.*",
      ".env",
      ".env.*",
      "*.env",
      "*.env.*",
      "env.local",
      "env.*.local",
      "*cookie*",
      "cookie*.txt",
      "*cookies.json",
      "*session*",
      "*.session",
      "*session.token",
      "*_session.json",
      "*token*",
      "*.token",
      "*tokens*",
      "*auth*",
      "auth.json",
      "*.auth",
      "*oauth*",
      "*oauth2*",
      "*bearer*",
      "*password*",
      "*passwd*",
      "*pwd.json",
      ".netrc",
      ".htpasswd",
      ".npmrc",
      ".pypirc",
      ".git-credentials",
      "*.pem",
      "*.key",
      "*.p8",
      "*.p12",
      "*.pfx",
      "*.jks",
      "*.keystore",
      "id_rsa*",
      "id_ed25519*",
      "id_ecdsa*",
      "id_dsa*",
      "*.ppk",
      "authorized_keys",
      "known_hosts",
      "*.kdbx",
      "*keychain*",
      "*keyring*",
      "*onebot11*",
      "*account*.json",
      "*login*.json",
      "*service-account*.json",
      "*terraform.tfstate*"
    ],
    "skipDirPatterns": [
      ".ssh",
      ".gnupg",
      ".git",
      ".aws",
      ".docker",
      ".password-store",
      "secrets",
      ".pki",
      ".npm",
      ".config/gcloud",
      ".config/gh",
      "keyrings",
      ".local/share/keyrings",
      "node_modules",
      ".cache"
    ],
    "valueRedactionKeys": [
      "apikey",
      "api_key",
      "secret",
      "token",
      "password",
      "passwd",
      "cookie",
      "authorization",
      "bearer",
      "credential",
      "private_key",
      "access_key"
    ],
    "redactedValueToken": "[已隐藏]",
    "knownCredentialPaths": {
      "note": "仅用于 deps.credentialFreshness：只 stat 取 mtime，只输出聚合天数，不输出路径。",
      "candidates": [
        "~/.dsh/credentials.json",
        "~/.dsh/auth.json",
        "~/.config/astrbot/data/cmd_config.json",
        "~/.config/napcat/config/onebot11.json",
        "~/.bilibili-cookie.json"
      ]
    },
    "reportOnly": {
      "allowed": [
        "聚合数量",
        "sensitivePathToken",
        "redactedValueToken"
      ],
      "forbidden": [
        "文件路径",
        "文件名",
        "目录名",
        "mtime 对应到具体文件"
      ]
    }
  },
  "budget": {
    "tailBytes": 262144,
    "tailLines": 500,
    "maxEntriesCounted": 100000,
    "maxDirEntries": 5000,
    "indicatorTimeoutMs": 3000,
    "scanTimeoutMs": 15000,
    "execTimeoutMs": 1000
  },
  "discovery": {
    "note": "先发现鱼再读窝；P1 与 P2 的结果必须合并而不是二选一（黑盒鱼 / 有窝没鱼都是真实现象）。",
    "dedupeKey": [
      "kind",
      "realpath",
      "port"
    ],
    "probeOrder": [
      {
        "id": "P0",
        "rule": "cliExplicit",
        "params": [
          "--root",
          "--fish",
          "--log",
          "--dedupe"
        ],
        "fallbackTo": "P1"
      },
      {
        "id": "P1",
        "rule": "processTable",
        "linux": [
          "/proc/<pid>/cmdline",
          "/proc/<pid>/cwd",
          "/proc/<pid>/exe",
          "/proc/<pid>/stat"
        ],
        "darwin": "ps -eo pid,ppid,lstart,command",
        "win32": "unsupported",
        "fallbackTo": "P2"
      },
      {
        "id": "P2",
        "rule": "knownStateRoots",
        "maxDepth": 2,
        "fallbackTo": "P3"
      },
      {
        "id": "P3",
        "rule": "homeShallowScan",
        "root": "~",
        "maxDepth": 2,
        "fallbackTo": "P4"
      },
      {
        "id": "P4",
        "rule": "noFishFound",
        "behaviour": "输出一行结论 + 一行下一步（不许空报告，也不许堆 unknown）"
      }
    ],
    "allowExec": [
      {
        "cmd": "ps",
        "args": [
          "-eo",
          "pid,ppid,lstart,command"
        ],
        "purpose": "darwin 进程表",
        "timeoutMs": 2000
      },
      {
        "cmd": "ffmpeg",
        "args": [
          "-version"
        ],
        "purpose": "取版本号",
        "timeoutMs": 1000,
        "enabledByDefault": false,
        "disableNote": "外部命令默认不执行；需要版本号时才显式开启"
      },
      {
        "cmd": "node",
        "args": [
          "--version"
        ],
        "purpose": "取版本号",
        "timeoutMs": 1000,
        "enabledByDefault": false,
        "disableNote": "外部命令默认不执行；需要版本号时才显式开启"
      },
      {
        "cmd": "<pid exe>",
        "args": [
          "--version"
        ],
        "purpose": "取鱼的运行时版本",
        "timeoutMs": 1000,
        "enabledByDefault": false,
        "disableNote": "外部命令默认不执行；需要版本号时才显式开启"
      }
    ],
    "kinds": [
      {
        "id": "dsh",
        "nameZh": "DSH 插件",
        "fingerprintAny": [
          "dsh",
          ".dsh",
          "opencode-go",
          "xiaomimimo"
        ],
        "stateCandidates": [
          "~/.dsh",
          "~/.config/dsh",
          "~/.local/share/dsh"
        ],
        "startHint": "在你的 DSH 里启动对应插件"
      },
      {
        "id": "astrbot",
        "nameZh": "AstrBot",
        "fingerprintAny": [
          "astrbot",
          "astrbot-main"
        ],
        "stateCandidates": [
          "~/.config/astrbot",
          "~/astrbot",
          "~/AstrBot",
          "~/.local/share/astrbot"
        ],
        "startHint": "进 AstrBot 目录跑 python main.py（或用它的启动脚本）"
      },
      {
        "id": "napcat",
        "nameZh": "NapCat",
        "fingerprintAny": [
          "napcat",
          "onebot",
          "llonebot"
        ],
        "stateCandidates": [
          "~/.config/napcat",
          "~/napcat",
          "~/.local/share/napcat"
        ],
        "startHint": "启动 NapCat 并按配置连上 OneBot 反向 WS"
      },
      {
        "id": "desktop-pet",
        "nameZh": "桌面宠物",
        "fingerprintAny": [
          "desktop-pet",
          "vpet",
          "live2d",
          "pet"
        ],
        "stateCandidates": [
          "~/.config/vpet",
          "~/.config/desktop-pet",
          "~/.local/share/desktop-pet"
        ],
        "startHint": "重新打开桌面宠物程序"
      },
      {
        "id": "unknown",
        "nameZh": "未识别的鱼",
        "fingerprintAny": [],
        "stateCandidates": [],
        "startHint": "用你平时启动她的那条命令",
        "note": "只做 liveness（进程启动时间）+ health（若找到日志），其余 unknown。"
      }
    ]
  },
  "indicators": {
    "liveness": {
      "id": "liveness",
      "nameZh": "存活",
      "question": "这条鱼最后一次真的动过是什么时候？",
      "unit": "sec",
      "forbiddenSignals": [
        "online",
        "isOnline",
        "connected",
        "status",
        "state",
        "alive",
        "heartbeat",
        "lastPing",
        "readyState",
        "lastSeenOnline"
      ],
      "forbiddenReason": "僵尸进程、假心跳、断线未重连的 bot 都能把 online 报成正常。只有真实写入痕迹算数。",
      "sources": [
        "log_mtime",
        "session_mtime",
        "dedupe_mtime",
        "process_start"
      ],
      "sourceOrder": [
        "log_mtime",
        "session_mtime",
        "dedupe_mtime",
        "process_start"
      ],
      "aggregation": "max",
      "excludedSources": [
        "config_mtime",
        "dir_mtime"
      ],
      "excludedReason": "改配置不等于干活；目录 mtime 可能只是有人 cd 进去过。",
      "thresholds": {
        "metric": "ageSec",
        "constants": {
          "activeMaxSec": 3600,
          "slackMaxSec": 86400,
          "dormantMaxSec": 604800,
          "futureSkewToleranceSec": 120
        },
        "bands": [
          {
            "level": "active",
            "allOf": [
              {
                "metric": "ageSec",
                "op": "lt",
                "valueRef": "activeMaxSec"
              }
            ]
          },
          {
            "level": "slack",
            "allOf": [
              {
                "metric": "ageSec",
                "op": "lt",
                "valueRef": "slackMaxSec"
              }
            ]
          },
          {
            "level": "dormant",
            "allOf": [
              {
                "metric": "ageSec",
                "op": "lt",
                "valueRef": "dormantMaxSec"
              }
            ]
          },
          {
            "level": "dead",
            "allOf": [
              {
                "metric": "ageSec",
                "op": "gte",
                "valueRef": "dormantMaxSec"
              }
            ]
          }
        ]
      },
      "diagnosis": {
        "active": {
          "severity": "ok",
          "phenomenon": "她 {ageHuman} 前还在动，是活的。",
          "nextStep": "不用管，继续养。",
          "fixShort": "不用管，继续养。",
          "vars": [
            "ageHuman"
          ]
        },
        "slack": {
          "severity": "watch",
          "phenomenon": "她今天醒过，但已经 {ageHuman} 没动静了，比平时安静。",
          "nextStep": "先等到今天收工再看一眼；如果明天还是这么安静，去看「健康」那栏有没有报错。",
          "fixShort": "明天还静就看「健康」",
          "vars": [
            "ageHuman"
          ]
        },
        "dormant": {
          "severity": "watch",
          "phenomenon": "她已经 {ageDays} 天没动过了 —— 可能在休息，也可能卡住了。",
          "nextStep": "打开她的日志看最后一行是什么时候；然后重启一次再观察半天，还不动就查「依赖」那栏缺什么。",
          "fixShort": "看日志最后一行再重启观察",
          "vars": [
            "ageDays"
          ]
        },
        "dead": {
          "severity": "bad",
          "phenomenon": "她从 {ageDays} 天前就没再动过，基本可以认定停了。",
          "nextStep": "先看进程还在不在：不在就按启动命令拉起来；还在就翻日志最后的报错，十有八九是登录过期或依赖缺失。",
          "fixShort": "进程不在就按启动命令拉起",
          "vars": [
            "ageDays"
          ]
        },
        "unknown": {
          "severity": "unknown",
          "phenomenon": "读不到她任何活动记录，判不出死活（不是正常）。",
          "nextStep": "指明她的窝：pond-check --root <她的目录>。",
          "fixShort": "用 --root 指明她的窝",
          "vars": []
        }
      },
      "variants": {
        "processCold": {
          "when": "evidence.processAlive === false",
          "phenomenonSuffix": " 而且进程不在 —— 现在没有任何进程在跑她。",
          "nextStepTemplate": "按启动命令拉起来：{startHint}，起来后等 10 分钟再体检一次。",
          "vars": [
            "startHint"
          ]
        }
      },
      "unknownWhen": [
        "sourceOrder 里所有源都不存在",
        "所有源的时间戳都无效（epoch 0 / 超出 futureSkewToleranceSec 的未来时间）",
        "该指标超时（reason=timeout）"
      ]
    },
    "rhythm": {
      "id": "rhythm",
      "nameZh": "节律",
      "question": "近 7 天她是不是每天都醒？还是三天打鱼两天晒网？",
      "unit": "days",
      "sources": [
        "log_timestamps",
        "session_timestamps",
        "dedupe_entry_dates"
      ],
      "sourceOrder": [
        "log_timestamps",
        "session_timestamps",
        "dedupe_entry_dates"
      ],
      "wakeDefinition": "某自然日（本地时区 00:00 分界）内出现 >= 1 条带时间戳的活动记录，即算一次唤醒。",
      "thresholds": {
        "metric": "activeDaysInWindow",
        "constants": {
          "windowDays": 7,
          "steadyMinActiveDays": 5,
          "driftingMinActiveDays": 3,
          "sparseMinActiveDays": 1
        },
        "bands": [
          {
            "level": "steady",
            "allOf": [
              {
                "metric": "activeDaysInWindow",
                "op": "gte",
                "valueRef": "steadyMinActiveDays"
              }
            ]
          },
          {
            "level": "drifting",
            "allOf": [
              {
                "metric": "activeDaysInWindow",
                "op": "gte",
                "valueRef": "driftingMinActiveDays"
              }
            ]
          },
          {
            "level": "sparse",
            "allOf": [
              {
                "metric": "activeDaysInWindow",
                "op": "gte",
                "valueRef": "sparseMinActiveDays"
              }
            ]
          },
          {
            "level": "stopped",
            "allOf": [
              {
                "metric": "activeDaysInWindow",
                "op": "eq",
                "value": 0
              }
            ]
          }
        ]
      },
      "displayMetrics": [
        "dailyCounts",
        "avgPerDay",
        "maxPerDay",
        "todayCount"
      ],
      "diagnosis": {
        "steady": {
          "severity": "ok",
          "phenomenon": "近 7 天有 {activeDays} 天醒来，平均每天 {avgPerDay} 次，作息是稳的。",
          "nextStep": "保持现状，不用动。",
          "fixShort": "保持现状",
          "vars": [
            "activeDays",
            "avgPerDay"
          ]
        },
        "drifting": {
          "severity": "watch",
          "phenomenon": "近 7 天只有 {activeDays} 天醒来过，节律开始散了。",
          "nextStep": "先想一下是不是你自己手动开她的次数少了；如果是自动跑的，去看定时任务/常驻进程还在不在（crontab -l、systemctl --user list-timers）。",
          "fixShort": "查 crontab 定时任务",
          "vars": [
            "activeDays"
          ]
        },
        "sparse": {
          "severity": "bad",
          "phenomenon": "近 7 天只醒了 {activeDays} 天，只是偶尔挣扎一下。",
          "nextStep": "当成「快停了」处理：先看「存活」「健康」两栏，再看「依赖」第一项（ffmpeg）是不是缺了。",
          "fixShort": "先看「存活」「健康」两栏",
          "vars": [
            "activeDays"
          ]
        },
        "stopped": {
          "severity": "bad",
          "phenomenon": "近 7 天一次都没醒。",
          "nextStep": "先看「存活」那栏：它要是也判 dead，就当已经停了，按启动命令拉起来。",
          "fixShort": "先看「存活」是否也是 dead",
          "vars": []
        },
        "unknown": {
          "severity": "unknown",
          "phenomenon": "没有一条带时间戳的记录，算不出节律（不是规律）。",
          "nextStep": "让她的日志按天切割（大多数 bot 框架都有这个开关），或者保留 session 文件别清；有按天记录体检才数得出来。",
          "fixShort": "日志按天切割、别清 session",
          "vars": []
        }
      },
      "unknownWhen": [
        "没有任何带可解析时间戳的记录",
        "该指标超时（reason=timeout）"
      ]
    },
    "throughput": {
      "id": "throughput",
      "nameZh": "工作量",
      "question": "她到底干了多少活？今天有没有干？",
      "unit": "count",
      "sources": [
        "dedupe_store",
        "dedupe_sqlite",
        "log_processed_lines"
      ],
      "sourceOrder": [
        "dedupe_store",
        "dedupe_sqlite",
        "log_processed_lines"
      ],
      "formats": [
        "json_array",
        "json_object_items",
        "jsonl",
        "lines",
        "sqlite"
      ],
      "thresholds": {
        "metric": "todayNew",
        "constants": {
          "stalledAfterDays": 3,
          "productiveTodayMin": 1,
          "sampleWindowDays": 7,
          "maxEntriesCounted": 100000
        },
        "bands": [
          {
            "level": "empty",
            "allOf": [
              {
                "metric": "totalEntries",
                "op": "lte",
                "value": 0
              }
            ]
          },
          {
            "level": "productive",
            "allOf": [
              {
                "metric": "todayNew",
                "op": "gte",
                "valueRef": "productiveTodayMin"
              }
            ]
          },
          {
            "level": "stalled",
            "allOf": [
              {
                "metric": "daysSinceLastNew",
                "op": "gte",
                "valueRef": "stalledAfterDays"
              }
            ]
          },
          {
            "level": "quiet",
            "allOf": [
              {
                "metric": "totalEntries",
                "op": "gt",
                "value": 0
              }
            ]
          }
        ],
        "timeFieldNames": [
          "processedAt",
          "processed_at",
          "ts",
          "time",
          "created_at",
          "createdAt",
          "date",
          "updatedAt"
        ],
        "sqliteMagic": "SQLite format 3"
      },
      "diagnosis": {
        "productive": {
          "severity": "ok",
          "phenomenon": "今天新处理了 {todayNew} 条，累计 {totalEntries} 条。",
          "nextStep": "不用动，她正常在出货。",
          "fixShort": "不用动",
          "vars": [
            "todayNew",
            "totalEntries"
          ]
        },
        "quiet": {
          "severity": "watch",
