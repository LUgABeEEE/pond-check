{
  "name": "pond-check",
  "version": "0.2.1",
  "description": "扫一遍你机器上所有在跑的鱼，出一页体检报告：谁活着、干了啥、哪儿坏了、怎么修。",
  "type": "module",
  "bin": {
    "pond-check": "src/cli.mjs"
  },
  "exports": {
    ".": "./src/cli.mjs",
    "./shared": "./src/shared/index.mjs",
    "./memory": "./src/memory/index.mjs",
    "./wake": "./src/wake/index.mjs",
    "./tts": "./src/tts/index.mjs",
    "./image": "./src/image/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "test:watch": "node --test --watch"
  },
  "keywords": [
    "dsh",
    "agent",
    "monitor",
    "diagnostics",
    "bilibili",
    "qq-bot",
    "observability"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LUgABeEEE/pond-check.git"
  }
}
